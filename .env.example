# DealFlowTracker — environment variables

# ── Required ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-key-here
SECRET_KEY=replace-me-with-a-long-random-string

# ── Model selection ──────────────────────────────────────────────────────
AI_MODEL=gpt-5-mini

# ── Database ─────────────────────────────────────────────────────────────
# Native: DATABASE_URL=sqlite:///./dealflow.db
# Docker compose: auto-set to postgresql://dealflow:dealflow@dealflowtracker_postgres:5432/dealflow
DATABASE_URL=

# ── Postgres credentials (only consumed by docker-compose.yml) ──────────
POSTGRES_DB=dealflow
POSTGRES_USER=dealflow
# Local-dev placeholder. Override via .env or a real secret store before any deploy.
POSTGRES_PASSWORD=change-me-in-production

# ── CORS / frontend URL ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5178
ALLOWED_ORIGINS=http://localhost:5178
VITE_API_URL=http://localhost:8006/api

# ── Brain bridge ─────────────────────────────────────────────────────────
BRAIN_URL=http://host.docker.internal:8000
BRAIN_TOKEN=
BRAIN_CONVERSATION=

# ── Fleet signing (Session 1133 PA-chat signing back-prop) ──────────────
# Required for HMAC-signed `/api/pa/chat/` calls to u-d-b. Without
# these set, brain_client falls back to bearer-only auth and u-d-b's
# audit table records `auth_mode=bearer_only` for every PA chat call.
#
# Mint via u-d-b:
#   python manage.py provision_fleet_identity --app-slug dealflowtracker
# The RAW SECRET is shown exactly ONCE — u-d-b stores only SHA256(secret).
FLEET_APP_SLUG=dealflowtracker
FLEET_KEY_ID=
FLEET_SERVICE_SECRET=
