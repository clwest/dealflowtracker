# DealFlowTracker — environment variables

# ── Required ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-key-here
SECRET_KEY=replace-me-with-a-long-random-string

# ── Model selection ──────────────────────────────────────────────────────
AI_MODEL=gpt-5-mini

# ── Database ─────────────────────────────────────────────────────────────
# Native: DATABASE_URL=sqlite:///./dealflow.db
# Docker compose: auto-set to postgresql://dealflow:dealflow@dealflowtracker_postgres:5432/dealflow
DATABASE_URL=

# ── Postgres credentials (only consumed by docker-compose.yml) ──────────
POSTGRES_DB=dealflow
POSTGRES_USER=dealflow
# Local-dev placeholder. Override via .env or a real secret store before any deploy.
POSTGRES_PASSWORD=change-me-in-production

# ── CORS / frontend URL ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5178
ALLOWED_ORIGINS=http://localhost:5178
VITE_API_URL=http://localhost:8006/api
